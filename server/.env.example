# Copy this file to .env and fill in your own values. NEVER commit .env
MONGODB_URI=mongodb://127.0.0.1:27017/carelink
# or Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/carelink?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=replace_with_a_long_random_string
CLIENT_URL=http://localhost:5173
# On first start the server creates the admin (rian@gmail.com / Rian@123) and the 3 demo accounts.
# Optional overrides: ADMIN_EMAIL, ADMIN_PASSWORD
NODE_ENV=development
